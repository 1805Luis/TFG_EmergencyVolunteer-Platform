name: dockercompose9786474554806460690
services:
  auth-db:
    container_name: auth-db
    environment:
      ACCEPT_EULA: "Y"
      MSSQL_PID: Express
      SA_PASSWORD: '%5Y8o5!*m80Un'
    image: mcr.microsoft.com/mssql/server
    networks:
      default: null
    ports:
      - mode: ingress
        target: 1433
        published: "14333"
        protocol: tcp
  authservice:
    build:
      context: C:\Users\Luis\Desktop\TFG-GestionVoluntariado\API-Gestion
      dockerfile: AuthService/Dockerfile
    container_name: autenticacion
    depends_on:
      auth-db:
        condition: service_started
        required: true
      rabbitmq:
        condition: service_started
        required: true
    environment:
      ASPNETCORE_ENVIRONMENT: Development
      ASPNETCORE_HTTP_PORTS: "8080"
    image: authservice
    networks:
      default: null
    ports:
      - mode: ingress
        target: 8080
        published: "8081"
        protocol: tcp
      - mode: ingress
        target: 8080
        protocol: tcp
  rabbitmq:
    container_name: rabbitmq
    environment:
      RABBITMQ_DEFAULT_PASS: guest
      RABBITMQ_DEFAULT_USER: guest
    image: rabbitmq:3-management
    networks:
      default: null
    ports:
      - mode: ingress
        target: 5672
        published: "5672"
        protocol: tcp
      - mode: ingress
        target: 15672
        published: "15672"
        protocol: tcp
  user-db:
    container_name: user-db
    environment:
      ACCEPT_EULA: "Y"
      MSSQL_PID: Express
      SA_PASSWORD: 7nqfX4G99p:y
    image: mcr.microsoft.com/mssql/server
    networks:
      default: null
    ports:
      - mode: ingress
        target: 1433
        published: "14334"
        protocol: tcp
  usuarios:
    build:
      context: C:\Users\Luis\Desktop\TFG-GestionVoluntariado\API-Gestion
      dockerfile: Usuarios/Dockerfile
    container_name: usuarios
    depends_on:
      auth-db:
        condition: service_started
        required: true
      rabbitmq:
        condition: service_started
        required: true
    image: usuarios
    networks:
      default: null
    ports:
      - mode: ingress
        target: 8080
        published: "8082"
        protocol: tcp
networks:
  default:
    name: dockercompose9786474554806460690_default